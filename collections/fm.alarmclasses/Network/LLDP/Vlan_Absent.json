{
    "name": "Network | LLDP | Vlan Absent",
    "$collection": "fm.alarmclasses",
    "uuid": "d7be1f8c-6e15-4d92-9379-3970eab53e44",
    "is_unique": true,
    "reference": ["interface", "vlan"],
    "is_ephemeral": false,
    "user_clearable": true,
    "components": [
        {
            "name": "interface",
            "model": "inv.Interface",
            "args": [{
                "param": "interface",
                "var": "interface"
            }]
        },
        {
            "name": "vlands",
            "model": "vc.VLAN",
            "args": [{
                "param": "vlan",
                "var": "vlan"
            }]
        }
    ],
    "vars": [
        {
            "name": "interface",
            "description": "Affected interface"
        },
        {
            "name": "description",
            "description": "Interface description",
            "default": "=components.interface.description"
        },
        {
            "name": "vlan",
            "description": "VLAN ID"
        },
        {
            "name": "vlan_name",
            "description": "Vlan name",
            "default": "=components.vlands.name"
        },
        {
            "name": "vlan_description",
            "description": "Vlan description",
            "default": "=components.vlands.description"
        },
        {
            "name": "neighbor",
            "description": "Remote System Name"
        },
        {
            "name": "neighbor_port",
            "description": "Remote Port"
        }
    ],
    "subject_template": "LLDP: Vlan {{vlan}} is missing on {{interface}}.",
    "body_template": "LLDP: Vlan {{vlan}}{% if vlan_name %} ({{vlan_name}}){% endif %} is missing on {{interface}}{% if description %} ({{description}}){% endif %}.{% if neighbor %}\nRemote system name: {{neighbor}}.{% endif %}{% if neighbor_port %}\nRemote port: {{neighbor_port}}.{% endif %}",
    "symptoms": "Lost traffic on specific vlan",
    "probable_causes": "",
    "recommended_actions": "Check configuration",
    "recover_time": 300,
    "labels": ["noc::severity::minor"]
}
