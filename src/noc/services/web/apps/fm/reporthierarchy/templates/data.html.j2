<style>
.category {
    font-weight: bold;
    background: #c0c0c0;
}

.item {
}

.offset {
    padding-left: 32px;
}

UL.rules, UL.rules LI {
    margin-left: 8pt;
    padding-left: 0pt;
    list-style-position: outside;
}
</style>
{% macro bool_icon(value) -%}
    {%- if value is none -%}
        ?
    {%- elif value -%}
        <img src='/ui/pkg/django-media/admin/img/icon-yes.svg' alt='Yes' />
    {%- else -%}
        <img src='/ui/pkg/django-media/admin/img/icon-no.svg' alt='No' />
    {%- endif -%}
{%- endmacro %}
<h2>Event Classes Hierarchy ({{ ne|e }} classes, {{ ncr|e }} rules)</h2>

<table>
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Action</th>
            <th>Vars</th>
            <th>Disposition</th>
            <th>Rules</th>
        </tr>
    </thead>
{% set row = namespace(index=0) %}
{% for level, c, rules in event_classes %}
    {% if level != -1 %}
    <tr class="category"><td colspan="6">{{ c|e }}</td></tr>
    {% else %}
    <tr class="item {{ 'row1' if row.index % 2 == 0 else 'row2' }}">
        {% set row.index = row.index + 1 %}
        <td>{{ c.name|e }}</td>
        <td>{{ c.description|e }}</td>
        <td>
            {% if c.action == "D" %}Drop{% endif %}
            {% if c.action == "L" %}Log{% endif %}
            {% if c.action == "A" %}Log + Archive{% endif %}
        </td>
        <td>
            {% for v in c.vars %}
                {% if not v.required %}<i>{% endif %}
                <b>{{ v.name|e }} ({{ v.type|e }}):</b> {{ v.description|e }}<br/>
                {% if not v.required %}</i>{% endif %}
            {% endfor %}
        </td>
        <td>
            {% for r in c.disposition %}
                <b>{{ r.name|e }}:</b><br/>if&nbsp;({{ r.condition|e }}):<br/>then&nbsp;{{ r.action|e }}
                {% if r.action == "raise" or r.action == "clear" %}<a href="#">{{ r.alarm_class.name|e }}</a>{% endif %}
                <br/>
            {% endfor %}
        </td>
        <td>
            <ul class="rules">
            {% for r in rules %}
                <li>{{ r.name|e }}</li>
            {% endfor %}
            </ul>
        </td>
    </tr>
    {% endif %}
{% endfor %}
</table>

<h2>Alarm Classes Hierarchy ({{ na|e }} total)</h2>
<table>
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Unique</th>
            <th>Discr.</th>
            <th>User clearable</th>
            <th>Vars</th>
            <th>Root Cause</th>
        </tr>
    </thead>
{% for level, a in alarm_classes %}
    {% if level != -1 %}
    <tr class="category"><td colspan="8">{{ a|e }}</td></tr>
    {% else %}
    <tr>
        <td>{{ a.name|e }}</td>
        <td>{{ a.description|e }}</td>
        <td>{{ bool_icon(a.is_unique) }}</td>
        <td>{{ a.discriminator|join(', ')|e }}</td>
        <td>{{ bool_icon(a.user_clearable) }}</td>
        <td>
            {% for v in a.vars %}
            <b>{{ v.name|e }}:</b> {{ v.description|e }}<br/>{% if v.default %}default: {{ v.default|e }}<br/>{% endif %}
            {% endfor %}
        </td>
        <td>
            {% for rc in a.root_cause %}
                <b>{{ rc.name|e }}:</b><br/>
                Root: {{ rc.root.name|e }}<br/>
                Window: {{ rc.window|e }}<br/>
                {% for k, v in rc.condition.items() %}
                    {{ k|e }}&nbsp;==&nbsp;{{ v|e }}<br/>
                {% endfor %}
            {% endfor %}
        </td>
    </tr>
    {% endif %}
{% endfor %}
</table>
