<table class="table table-condensed table-hover">
<tbody>
    <tr>
        <th colspan="2">
            Platform: {{ object.vendor.name }} {{ object.name }}
        </th>
    </tr>
    {% if object.aliases %}
    <tr>
        <th scope="row">{{ t("header-aliases") }}</th>
        <td>{{", ".join(object.aliases)}}</td>
    <tr>
    {% endif %}
    <tr>
        <th scope="row">{{ t("header-description") }}</th>
        <td>{{object.description}}</td>
    <tr>
    {% if object.start_of_sale %}
    <tr>
        <th scope="row">{{ t("header-start-of-sale") }}</th>
        <td>{{object.start_of_sale}}</td>
    <tr>
    {% endif %}
    {% if object.end_of_sale %}
    <tr>
        <th scope="row">{{ t("header-end-of-sale") }}</th>
        <td>{{object.end_of_sale}}</td>
    <tr>
    {% endif %}
    {% if object.end_of_support %}
    <tr>
        <th scope="row">{{ t("header-end-of-support") }}</th>
        <td>{{object.end_of_support}}</td>
    <tr>
    {% endif %}
    {% if object.end_of_xsupport %}
    <tr>
        <th scope="row">{{ t("header-end-of-ext-support") }}</th>
        <td>{{object.end_of_xsupport}}</td>
    <tr>
    {% endif %}
    {% if object.snmp_sysobjectid %}
    <tr>
        <th scope="row">{{ t("header-snmp-sysobjectid") }}</th>
        <td>{{object.snmp_sysobjectid}}</td>
    <tr>
    {% endif %}
</tbody>
</table>
