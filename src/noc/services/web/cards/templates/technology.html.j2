<table class="table table-condensed table-hover">
<tbody>
</tbody>
<tr>
    <th colspan="2">
        {{ object.name }}
    </th>
</tr>
<tr>
    <th scope="row" class="col-md-2">
        {{ t("header-description") }}
    </th>
    <td>
        {% if object.description %} {{ object.description }} {% endif %}
    </td>
</tr>
<tr>
    <th scope="row" class="col-md-2">
        {{ t("header-service-model") }}
    </th>
    <td>
        {% if object.service_model %} {{ object.service_model }} {% endif %}
    </td>
</tr>
<tr>
    <th scope="row" class="col-md-2">
        {{ t("header-client-model") }}
    </th>
    <td>
        {% if object.client_model %} {{ object.client_model }} {% endif %}
    </td>
</tr>
<tr>
    <th scope="row" class="col-md-2">
        {{ t("header-single-service") }}
    </th>
    <td>
        {{ object.single_service }}
    </td>
</tr>
<tr>
    <th scope="row" class="col-md-2">
        {{ t("header-single-client") }}
    </th>
    <td>
        {{ object.single_client }}
    </td>
</tr>
<tr>
    <th scope="row" class="col-md-2">
        {{ t("header-allow-children") }}
    </th>
    <td>
        {{ object.allow_children }}
    </td>
</tr>
</table>
