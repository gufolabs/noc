<div class="row">
    <div class="col-md-6">
        <table class="table table-condensed table-hover">
        <tbody>
            <tr>
                <th colspan="2">
                    <a href="/api/card/view/vrf/{{ object.vrf.id }}/">{{ object.vrf.name }}</a> |
                    IPv{{ object.afi }} |
                    {% for p in path%}
                    <a href="/api/card/view/prefix/{{ p.id }}/" title="{{ p.name }}">{{ p.prefix }}</a> |
                    {% endfor %}
                    {{ object.prefix }}
                </th>
            </tr>
            <tr>
                <th scope="row">{{ t("header-name") }}</th>
                <td>{{object.name}}</td>
            <tr>
            <tr>
                <th scope="row">{{ t("header-profile") }}</th>
                <td>{{object.profile.name}}</td>
            <tr>
            {% if object.asn %}
            <tr>
                <th scope="row">{{ t("header-as") }}</th>
                <td>{% if object.asn.as_name %}{{object.asn.as_name}} (AS{{ object.asn.asn }}){% else %}AS{{ object.asn.asn }}{% endif %}</td>
            <tr>
            {% endif %}
            <tr>
                <th scope="row">{{ t("header-state") }}</th>
                <td>{{object.state.name}}</td>
            <tr>
            <tr>
                <th scope="row">{{ t("header-description") }}</th>
                <td>{{object.description}}</td>
            <tr>
            <tr>
                <th scope="row">{{ t("header-source") }}</th>
                <td>{{source}}</td>
            </tr>
        </tbody>
        </table>
    </div>
    <div class="col-md-6">
        <div class="row">
            <div class="col-md-12 text-center">Pools</div>
        </div>
        <table class="table table-condensed table-hover">
            <thead>
            <tr>
                <th>{{ t("header-name") }}</th>
                <th>{{ t("header-description") }}</th>
                <th>{{ t("header-usage") }}</th>
            </tr>
        </thead>
        <tbody>
        {% for p in pools %}
            <tr>
                <td><a href="/api/card/view/resourcepool/{{ p.id }}/">{{ p.name }}</a></td>
                <td>{{ p.description | default('-', true) }}</td>
                <td>{{ p.usage }}</td>
            </tr>
        {% endfor %}
        </tbody>
        </table>
    </div>
</div>
{% if prefixes %}
<table class="table table-condensed table-hover">
<thead>
<tr>
    <th>{{ t("header-prefix") }}</th>
    <th>{{ t("header-state") }}</th>
    <th>{{ t("header-as") }}</th>
    <th>{{ t("header-vlan-6c174b") }}</th>
    <th>{{ t("header-last-seen-20c226") }}</th>
    <th>{{ t("header-size-usage") }}</th>
</tr>
</thead>
<tbody>
{% for p in prefixes %}
    <tr>
        <td><a href="/api/card/view/prefix/{{ p.id }}/">{{ p.prefix }}</a></td>
        <td>{{ p.state }}</td>
        <td>{% if p.as %}AS{{ p.as }}{% endif %}</td>
        <td>{{ p.vlan | default('-', true)  }}</td>
        <td>{{ p.last_seen | default('-', true) }}</td>
        <td>{{ p.usage }}</td>
    </tr>
{% endfor %}
</tbody>
</table>
{% endif %}
{% if addresses %}
<table class="table table-condensed table-hover">
<thead>
<tr>
    <th>{{ t("header-address") }}</th>
    <th>{{ t("header-state") }}</th>
    <th>{{ t("header-last-seen-20c226") }}</th>
    <th>{{ t("header-device") }}</th>
    <th>{{ t("header-mac") }}</th>
    <th>{{ t("header-fqdn") }}</th>
    <th>{{ t("header-allocated-c249df") }}</th>
</tr>
</thead>
<tbody>
{% for a in addresses %}
    <tr>
        <td><a href="/api/card/view/address/{{ a.id }}/">{{ a.address }}</a></td>
        <td>{{ a.state }}</td>
        <td>{{ a.last_seen | default('-', true) }}</td>
        <td>-</td>
        <td>{{ a.mac | default('-', true) }}</td>
        <td>{{ a.fqdn | default('-', true) }}</td>
        <td>{{ a.allocated_till | default('-', true) }}</td>
    </tr>
{% endfor %}
</tbody>
</table>
{% endif %}
