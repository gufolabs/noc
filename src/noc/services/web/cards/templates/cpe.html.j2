<table class="table table-condensed table-hover">
<tbody>
    <tr>
        <th colspan="2">
            {{ object.global_id }} CPE
        </th>
    </tr>
    <tr>
        <th scope="row">{{ t("header-profile") }}</th>
        <td>{{object.profile.name}}</td>
    <tr>
    {% if object.description %}
    <tr>
        <th scope="row">{{ t("header-description") }}</th>
        <td>{{object.description}}</td>
    </tr>
    {% endif %}
    <tr>
        <th scope="row">{{ t("header-local-id") }}</th>
        <td>{{ object.controller.name }}{{ object.local_id }} </td>
    <tr>
</tbody>
</table>
