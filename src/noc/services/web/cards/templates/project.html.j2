<table class="table table-condensed table-hover">
<tbody>
    <tr>
        <th scope="row">{{ t("header-name") }}</th>
        <td>{{object.name}}</td>
    <tr>
    {% if object.description %}
    <tr>
        <th scope="row">{{ t("header-description") }}</th>
        <td>{{object.description}}</td>
    <tr>
    {% endif %}

    {% if suppliers %}
    <tr>
        <th scope="row">{{ t("header-supplier") }}</th>
        <td>
            <table class="table">
                <thead>
                    <th>{{ t("header-name") }}</th>
                    <th>{{ t("header-profile") }}</th>
                    <th>{{ t("header-state") }}</th>
                    <th>{{ t("header-is-affilated") }}</th>
                </thead>
                <tbody>
                    {% for s in suppliers %}
                        <tr>
                            <td>{{ s.name }}</td>
                            <td>{{ s.profile.name }}</td>
                            <td>{{ s.state.name }}</td>
                            <td>{% if s.is_affilated%}{{ _("Yes") }}{% else %}{{ _("No") }}{% endif %}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </td>
    <tr>
    {% endif %}

    {% if subscribers %}
    <tr>
        <th scope="row">{{ t("header-subscribers-6f13df") }}</th>
        <td>
            <table class="table">
                <thead>
                    <th>{{ t("header-name") }}</th>
                    <th>{{ t("header-profile") }}</th>
                    <th>{{ t("header-state") }}</th>
                    <th>{{ t("header-address") }}</th>
                    <th>{{ t("header-tech-contact") }}</th>
                    <th>{{ t("header-tech-contact-phone") }}</th>
                </thead>
                <tbody>
                    {% for s in subscribers %}
                        <tr>
                            <td>{{ s.name }}</td>
                            <td>{{ s.profile.name }}</td>
                            <td>{{ s.state.name }}</td>
                            <td>{{ s.address}}</td>
                            <td>{{ s.tech_contact_person }}</td>
                            <td>{{ s.tech_contact_phone }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </td>
    <tr>
    {% endif %}

    {% if vrfs %}
    <tr>
        <th scope="row">{{ t("header-vrf") }}</th>
        <td>
            <table class="table">
                <thead>
                    <th>{{ t("header-name") }}</th>
                    <th>{{ t("header-state") }}</th>
                </thead>
                <tbody>
                    {% for vrf in vrfs %}
                        <tr>
                            <td><a href="/api/card/view/vrf/{{ vrf.id }}/">{{ vrf.name }}</a></td>
                            <td>{{ vrf.state.name }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </td>
    <tr>
    {% endif %}

    {% if prefixes %}
    <tr>
        <th scope="row">{{ t("header-prefix") }}</th>
        <td>
            <table class="table">
                <thead>
                    <th>{{ t("header-vrf") }}</th>
                    <th>{{ t("header-prefix") }}</th>
                    <th>{{ t("header-name") }}</th>
                    <th>{{ t("header-state") }}</th>
                </thead>
                <tbody>
                    {% for prefix in prefixes %}
                        <tr>
                            <td><a href="/api/card/view/vrf/{{ prefix.vrf.id }}/">{{ prefix.vrf.name }}</a></td>
                            <td><a href="/api/card/view/prefix/{{ prefix.id }}/">{{ prefix.prefix }}</a></td>
                            <td>{{ prefix.name }}</td>
                            <td>{{ prefix.state.name }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </td>
    <tr>
    {% endif %}

    {% if addresses %}
    <tr>
        <th scope="row">{{ t("header-address") }}</th>
        <td>
            <table class="table">
                <thead>
                    <th>{{ t("header-vrf") }}</th>
                    <th>{{ t("header-address") }}</th>
                    <th>{{ t("header-name") }}</th>
                    <th>{{ t("header-state") }}</th>
                </thead>
                <tbody>
                    {% for address in addresses %}
                        <tr>
                            <td><a href="/api/card/view/vrf/{{ address.vrf.id }}/">{{ address.vrf.name }}</a></td>
                            <td><a href="/api/card/view/address/{{ address.id }}/">{{ address.address }}</a></td>
                            <td>{{ address.name }}</td>
                            <td>{{ address.state.name }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </td>
    <tr>
    {% endif %}

    {% if dns_zones %}
    <tr>
        <th scope="row">{{ t("header-dns-zone") }}</th>
        <td>
            <table class="table">
                <thead>
                    <th>{{ t("header-name") }}</th>
                    <th>{{ t("header-serial") }}</th>
                </thead>
                <tbody>
                    {% for zone in dns_zones %}
                        <tr>
                            <td>{{ zone.name }}</td>
                            <td>{{ zone.serial }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </td>
    <tr>
    {% endif %}

    {% if managed_objects %}
    <tr>
        <th scope="row">{{ t("header-managed-objects") }}</th>
        <td>
            <table class="table">
                <thead>
                    <th>{{ t("header-object") }}</th>
                    <th>{{ t("header-address") }}</th>
                </thead>
                <tbody>
                    {% for mo in managed_objects %}
                        <tr>
                            <td><a href="/api/card/view/managedobject/{{ mo.id }}/">{{ mo.name }}</a></td>
                            <td>{{ mo.address }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </td>
    <tr>
    {% endif %}

    {% if interfaces %}
    <tr>
        <th scope="row">{{ t("header-interface") }}</th>
        <td>
            <table class="table">
                <thead>
                    <th>{{ t("header-object") }}</th>
                    <th>{{ t("header-interface") }}</th>
                    <th>{{ t("header-state") }}</th>
                </thead>
                <tbody>
                    {% for iface in interfaces %}
                        <tr>
                            <td><a href="/api/card/view/managedobject/{{ iface.managed_object.id }}/">{{ iface.managed_object.name }}</a></td>
                            <td>{{ iface.name }}</td>
                            <td>{{ iface.state }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </td>
    <tr>
    {% endif %}

    {% if sub_interfaces %}
    <tr>
        <th scope="row">{{ t("header-sub-interfaces") }}</th>
        <td>
            <table class="table">
                <thead>
                    <th>{{ t("header-object") }}</th>
                    <th>{{ t("header-sub-interface") }}</th>
                </thead>
                <tbody>
                    {% for siface in sub_interfaces %}
                        <tr>
                            <td><a href="/api/card/view/managedobject/{{ siface.managed_object.id }}/">{{ siface.managed_object.name }}</a></td>
                            <td>{{ siface.name }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </td>
    <tr>
    {% endif %}

    {% if assets %}
    <tr>
        <th scope="row">{{ t("header-as-set") }}</th>
        <td>
            <table class="table">
                <thead>
                    <th>{{ t("header-name") }}</th>
                </thead>
                <tbody>
                    {% for asset in assets %}
                        <tr>
                            <td>{{ asset.name }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </td>
    <tr>
    {% endif %}

    {% if ases %}
    <tr>
        <th scope="row">{{ t("header-as") }}</th>
        <td>
            <table class="table">
                <thead>
                    <th>{{ t("header-name") }}</th>
                    <th>{{ t("header-as") }}</th>
                </thead>
                <tbody>
                    {% for asn in ases %}
                        <tr>
                            <td>{{ asn.name }}</td>
                            <td>{{ asn.asn }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </td>
    <tr>
    {% endif %}

    {% if peers %}
    <tr>
        <th scope="row">{{ t("header-peer") }}</th>
        <td>
            <table class="table">
                <thead>
                    <th>{{ t("header-peer") }}</th>
                </thead>
                <tbody>
                    {% for peer in peers %}
                        <tr>
                            <td>{{ peer.name }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </td>
    <tr>
    {% endif %}

    {% if phoneranges %}
    <tr>
        <th scope="row">{{ t("header-phone-range") }}</th>
        <td>
            <table class="table">
                <thead>
                    <th>{{ t("header-dialplan") }}</th>
                    <th>{{ t("header-name") }}</th>
                    <th>{{ t("header-range") }}</th>
                    <th>{{ t("header-state") }}</th>
                </thead>
                <tbody>
                    {% for r in phoneranges %}
                        <tr>
                            <td><a href="/api/card/view/dialplan/{{ r.dialplan.id }}/">{{ r.dialplan.name }}</a></td>
                            <td>{{ r.name }}</td>
                            <td>{{ r.from_number }} - {{ r.to_number }}</td>
                            <td>{{ r.state.name }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </td>
    <tr>
    {% endif %}

    {% if phonenumbers %}
    <tr>
        <th scope="row">{{ t("header-phone-number") }}</th>
        <td>
            <table class="table">
                <thead>
                    <th>{{ t("header-dialplan") }}</th>
                    <th>{{ t("header-name") }}</th>
                    <th>{{ t("header-number") }}</th>
                    <th>{{ t("header-state") }}</th>
                </thead>
                <tbody>
                    {% for n in phonenumbers %}
                        <tr>
                            <td><a href="/api/card/view/dialplan/{{ n.dialplan.id }}/">{{ n.dialplan.name }}</a></td>
                            <td>{{ n.name }}</td>
                            <td>{{ n.number }}</td>
                            <td>{{ n.state.name }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </td>
    <tr>
    {% endif %}

    {% if vpns %}
    <tr>
        <th scope="row">{{ t("header-vpn") }}</th>
        <td>
            <table class="table">
                <thead>
                    <th>{{ t("header-number") }}</th>
                </thead>
                <tbody>
                    {% for vpn in vpns %}
                        <tr>
                            <td>{{ vpn.name }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </td>
    <tr>
    {% endif %}

    {% if vlans %}
    <tr>
        <th scope="row">{{ t("header-vlan-560367") }}</th>
        <td>
            <table class="table">
                <thead>
                    <th>{{ t("header-segment-44986c") }}</th>
                    <th>{{ t("header-name") }}</th>
                    <th>{{ t("header-vlan-560367") }}</th>
                </thead>
                <tbody>
                    {% for vlan in vlans %}
                        <tr>
                            <td><a href="/api/card/view/l2domain/{{ vlan.l2_domain.id }}/">{{ vlan.l2domain.name }}</a></td>
                            <td>{{ vlan.name }}</td>
                            <td>{{ vlan.vlan }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </td>
    <tr>
    {% endif %}
</tbody>
</table>
