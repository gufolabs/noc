<table class="table table-condensed table-hover">
<tbody>
</tbody>
<tr>
    <th colspan="2">
        {{ object.name }}
    </th>
</tr>
{% if object.parent %}
<tr>
    <th scope="row" class="col-md-2">
        {{ t("header-parent") }}
    </th>
    <td>
        <a href="/api/card/view/resourcegroup/{{ object.parent.id }}/">{{ object.parent.name }}</a>
    </td>
</tr>
{% endif %}
<tr>
    <th scope="row" class="col-md-2">
        {{ t("header-technology") }}
    </th>
    <td>
        <a href="/api/card/view/technology/{{ technology.id }}/">{{ technology.name }}</a>
    </td>
</tr>
<tr>
    <th scope="row" class="col-md-2">
        {{ t("header-description") }}
    </th>
    <td>
        {% if object.description %} {{ object.description }} {% endif %}
    </td>
</tr>
{% if allow_services %}
<tr>
    <th scope="row" class="col-md-2">
        {{ t("header-provide-resources") }}
    </th>
    <td>
        {% for g in services %}
        <a href="/api/card/view/{{ g["card"] }}/{{ g["id"] }}/">{{ g["label"] }}</a><br>
        {% endfor %}
    </td>
</tr>
{% endif %}
{% if allow_clients %}
<tr>
    <th scope="row" class="col-md-2">
        {{ t("header-consume-resources") }}
    </th>
    <td>
        {% for g in clients %}
        <a href="/api/card/view/{{ g["card"] }}/{{ g["id"] }}/">{{ g["label"] }}</a><br>
        {% endfor %}
    </td>
</tr>
{% endif %}
{% if children %}
<tr>
    <th scope="row" class="col-md-2">
        {{ t("header-nested-groups") }}
    </th>
    <td>
        <table class="table table-condensed table-hover">
            <thead>
                <th>{{ t("header-group") }}</th>
                <th>{{ t("header-technology") }}</th>
            </thead>
            <tbody>
            {% for g in children %}
                <tr>
                    <td><a href="/api/card/view/resourcegroup/{{ g.id }}/">{{ g.name }}</a></td>
                    <td><a href="/api/card/view/technology/{{ g.technology.id }}/">{{ g.technology.name }}</a></td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </td>
</tr>
{% endif %}
</table>
