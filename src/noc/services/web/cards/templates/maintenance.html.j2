<table class="table table-condensed table-hover">
<tbody>
    <tr>
        <th colspan="2" class="{{ {"before": "warning", "progress": "danger", "complete": "success"}[status] }}">
            {{ title }}
        </th>
    </tr>
    <tr>
        <th scope="row" class="col-sm-1">{{ t("header-type") }}</th>
        <td>{{ object.type.name }}</td>
    </tr>
    <tr>
        <th scope="row">{{ t("header-date") }}</th>
        <td>{{ start | timestamp }} - {{ stop | timestamp }}</td>
    </tr>
    <tr>
        <th scope="row">{{ t("header-services") }}</th>
        <td>{{ summary | glyph_summary }}</td>
    </tr>
    <tr>
        <th scope="row">{{ t("header-description") }}</th>
        <td>{{ description }}</td>
    </tr>
    {% if object.time_pattern %}
    <tr>
        <th scope="row" class="col-sm-1">{{ t("header-time-pattern") }}</th>
        <td>
            <a href="/api/card/view/timepattern/{{ object.time_pattern.id }}/">{{ object.time_pattern.name }}</a>
        </td>
    <tr>
    {% endif %}
    {% if object.escalation_tt %}
    <tr>
        <th scope="row">{{ t("header-escalation") }}</th>
        <td>
            TT <a href="/api/card/view/tt/{{ object.escalation_tt }}/">{{ object.escalation_tt }}</a>
        </td>
    </tr>
    {% endif %}
    <tr>
        <th scope="row">{{ t("header-contacts") }}</th>
        <td>{{ contacts }}</td>
    </tr>
    <tr>
        <th scope="row">{{ t("header-affected-objects") }}</th>
        <td>
            <table>
                <thead>
                    <th class="col-xs-4">{{ t("header-object") }}</th>
                    <th class="col-xs-2">{{ t("header-model") }}</th>
                    <th class="col-xs-2">{{ t("header-ip") }}</th>
                    <th class="col-xs-4">{{ t("header-services") }}</th>
                </thead>
                <tbody>
                    {% for a in affected %}
                    <tr>
                        <td>
                            <a href="/api/card/view/managedobject/{{ a["id"] }}/" target="_blank">{{ a["name"] }}</a>
                            <br/>
                            <span class="small">{{ a["object"] | object_location if a["object"] }}</span>
                        </td>
                        <td>{{ a["platform"] }}</td>
                        <td>{{ a["address"] }}</td>
                        <td>{{ a["summary"] | glyph_summary }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </td>
    </tr>
</tbody>
</table>
