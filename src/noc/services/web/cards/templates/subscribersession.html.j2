{% if macs %}
<table class="table table-condensed">
    <thead>
        <tr>
            <th>{{ t("header-vlan-560367") }}</th>
            <th>{{ t("header-mac") }}</th>
            <th>{{ t("header-mac-vendor") }}</th>
        <tr>
    </thead>
    <tbody>
        {% for m in macs %}
        <tr>
            <td>{{ m["vlan_id"] }}</td>
            <td>{{ m["mac"] }}</td>
            <td>{{ m["mac_vendor"] }}</td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
No MAC addresses found
{% endif %}
