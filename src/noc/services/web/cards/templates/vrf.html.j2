<table class="table table-condensed table-hover">
<tbody>
    <tr>
        <th colspan="2">
            {{ object.name }} VRF
        </th>
    </tr>
    <tr>
        <th scope="row">{{ t("header-profile") }}</th>
        <td>{{object.profile.name}}</td>
    <tr>
    <tr>
        <th scope="row">{{ t("header-rd") }}</th>
        <td>{{ object.rd }}</td>
    <tr>
    {% if object.description %}
    <tr>
        <th scope="row">{{ t("header-description") }}</th>
        <td>{{object.description}}</td>
    </tr>
    {% endif %}
    <tr>
        <th scope="row">{{ t("header-vpn-id") }}</th>
        <td>{{ object.vpn_id }}</td>
    <tr>
    <tr>
        <th scope="row">{{ t("header-prefixes") }}</th>
        <td>
            {% if ipv4_prefix %}<a href="/api/card/view/prefix/{{ ipv4_prefix.id }}/">IPv4</a>{% endif %}
            {% if ipv6_prefix %}<a href="/api/card/view/prefix/{{ ipv6_prefix.id }}/">IPv6</a>{% endif %}
        </td>
    <tr>
</tbody>
</table>
